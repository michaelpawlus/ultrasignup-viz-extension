{
  "manifest_version": 3,
  "name": "UltraSignup Race Visualizer",
  "version": "1.0.2",
  "description": "See how a runner’s finish time compares with the field on UltraSignup, with a histogram that follows age and division filters.",
  "content_scripts": [
    {
      "matches": [
        "https://ultrasignup.com/results_event.aspx*"
      ],
      "js": [
        "chart.min.js",
        "core.js",
        "scraper.js",
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
